{
  "uid": "bikes-model-monitoring",
  "title": "Model monitoring",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "1h",
  "tags": [
    "bikes"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Daily MAE of the median forecast",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bikes-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bikes-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, source || ' v' || model_version AS metric, mae AS value FROM forecast_scores WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Daily 80% interval coverage (target 0.8)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bikes-pg"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bikes-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, source || ' v' || model_version AS metric, coverage_80 AS value FROM forecast_scores WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Feature drift (PSI, last 28 days vs the same weeks in earlier years; alert above 0.2)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bikes-pg"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bikes-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, feature AS metric, psi AS value FROM feature_drift WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latest issued forecast",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bikes-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bikes-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source, model_version, origin, max(issued_at) AS issued_at, count(DISTINCT counter_id) AS counters, count(*) AS rows FROM forecasts GROUP BY source, model_version, origin ORDER BY max(issued_at) DESC LIMIT 10"
        }
      ]
    }
  ]
}